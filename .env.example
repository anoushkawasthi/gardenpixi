# Copy to .env.local and fill for EmailJS (Phase 9). Never commit .env.local.
# Next.js exposes only NEXT_PUBLIC_* to the browser bundle.

# Optional — canonical / Open Graph base URL for production (Phase 13).
# NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=

# Optional — shown as "Open mail" when EmailJS env is unset (Phase 9 fallback).
NEXT_PUBLIC_CONTACT_MAILTO=